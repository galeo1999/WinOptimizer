<UserControl x:Class="WinOptimizer.Views.PrivacyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#111827">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <Grid Margin="30">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">

                <TextBlock Text="Privacy"
                           Foreground="White"
                           FontSize="28"
                           FontWeight="Bold"/>

                <TextBlock Text="Windows privacy settings"
                           Foreground="#9CA3AF"
                           FontSize="14"
                           Margin="0,5,0,0"/>

            </StackPanel>

            <StackPanel x:Name="PrivacyTweaksPanel"
                        Grid.Row="2"/>

        </Grid>

    </ScrollViewer>

</UserControl>