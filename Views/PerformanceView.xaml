<UserControl x:Class="WinOptimizer.Views.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#111827">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <Grid Margin="30">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->

            <StackPanel Grid.Row="0">

                <TextBlock Text="Performance"
                           Foreground="White"
                           FontSize="28"
                           FontWeight="Bold"/>

                <TextBlock Text="Startup and background performance analysis"
                           Foreground="#9CA3AF"
                           FontSize="14"
                           Margin="0,5,0,0"/>

            </StackPanel>

            <!-- Startup Section -->

            <StackPanel Grid.Row="2">

                <TextBlock Text="Startup Applications"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="SemiBold"/>

                <TextBlock x:Name="StartupCountText"
                           Text="Scanning..."
                           Foreground="#9CA3AF"
                           FontSize="13"
                           Margin="0,5,0,15"/>

                <StackPanel x:Name="StartupAppsPanel"/>

            </StackPanel>

        </Grid>

    </ScrollViewer>

</UserControl>