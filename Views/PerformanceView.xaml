<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:ns2="clr-namespace:WinOptimizer.Views" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="WinOptimizer.Views.PerformanceView" Unloaded="PerformanceMemory_Unloaded" Background="#111827" Foreground="#CBD5E1" xmlns:views="clr-namespace:WinOptimizer.Views" xmlns:models="clr-namespace:WinOptimizer.Models">
    <UserControl.Resources>
        <ns2:MemoryBytesConverter x:Key="MemoryBytes" />
        <Style x:Key="MemoryLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9CA3AF" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="MemoryValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Margin" Value="0,4,10,14" />
        </Style>
        <Style x:Key="PerformanceButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#374151" />
            <Setter Property="Foreground" Value="#F9FAFB" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="#475569" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="#60A5FA" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource PerformanceButtonStyle}" />
        <Style x:Key="PerformanceTabStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="Padding" Value="20,10" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabSurface" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,3" CornerRadius="7,7,0,0">
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="#1E293B" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="#1F2937" />
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="#3B82F6" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TabSurface" Property="BorderBrush" Value="#93C5FD" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PerformanceCard" TargetType="Border">
            <Setter Property="Background" Value="#1F2937" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0">
            <TextBlock Text="Performance" Foreground="White" FontSize="28" FontWeight="Bold" />
            <TextBlock Text="Overview, memory, processes, startup and background" Foreground="#9CA3AF" Margin="0,4,0,0" />
        </StackPanel>
        <WrapPanel Margin="0,18,0,16" Grid.Row="1">
            <RadioButton x:Name="OverviewTab" Content="Overview" GroupName="PerformanceSections" Style="{StaticResource PerformanceTabStyle}" Tag="{x:Static views:PerformanceSection.Overview}" Click="NavigatePerformance_Click" />
            <RadioButton x:Name="MemoryTab" Content="Memory" GroupName="PerformanceSections" Style="{StaticResource PerformanceTabStyle}" Tag="{x:Static views:PerformanceSection.Memory}" Click="NavigatePerformance_Click" />
            <RadioButton x:Name="ProcessesTab" Content="Processes" GroupName="PerformanceSections" Style="{StaticResource PerformanceTabStyle}" Tag="{x:Static views:PerformanceSection.Processes}" Click="NavigatePerformance_Click" />
            <RadioButton x:Name="StartupTab" Content="Startup" GroupName="PerformanceSections" Style="{StaticResource PerformanceTabStyle}" Tag="{x:Static views:PerformanceSection.Startup}" Click="NavigatePerformance_Click" />
            <RadioButton x:Name="BackgroundTab" Content="Background" GroupName="PerformanceSections" Style="{StaticResource PerformanceTabStyle}" Tag="{x:Static views:PerformanceSection.Background}" Click="NavigatePerformance_Click" />
        </WrapPanel>
        <Grid Grid.Row="2">
            <ScrollViewer x:Name="OverviewSection" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <DockPanel Margin="0,0,0,12">
                        <Button x:Name="RefreshOverviewButton" Content="Refresh Overview" DockPanel.Dock="Right" Click="RefreshPerformanceOverview_Click" />
                        <TextBlock Text="{Binding Text, ElementName=MemoryStatusText}" Foreground="#9CA3AF" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
                    </DockPanel>
                    <UniformGrid x:Name="OverviewCards" Columns="2">
                        <Border Style="{StaticResource PerformanceCard}" Margin="0,0,12,12" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Memory" FontSize="18" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <TextBlock Text="Used RAM" Style="{StaticResource MemoryLabel}" />
                                <TextBlock Text="{Binding Memory.UsedBytes, Converter={StaticResource MemoryBytes}, FallbackValue=Unavailable}" Style="{StaticResource MemoryValue}" Margin="0,3,0,8" />
                                <WrapPanel>
                                    <TextBlock Text="Available: " />
                                    <TextBlock Text="{Binding Memory.AvailableBytes, Converter={StaticResource MemoryBytes}, FallbackValue=Unavailable}" />
                                </WrapPanel>
                                <TextBlock Text="{Binding Memory.PhysicalUsagePercentage, StringFormat={}Physical RAM: {0:F1}% used, TargetNullValue=Physical RAM unavailable, FallbackValue=Physical RAM unavailable}" Margin="0,8,0,0" />
                                <TextBlock Text="{Binding Memory.CommitUsagePercentage, StringFormat={}Commit: {0:F1}% used, TargetNullValue=Commit unavailable, FallbackValue=Commit unavailable}" />
                                <Button Content="View Memory" Tag="{x:Static views:PerformanceSection.Memory}" Click="NavigatePerformance_Click" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="10,6" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PerformanceCard}" Margin="0,0,0,12" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Memory Pressure" FontSize="18" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <TextBlock Text="{Binding Memory.PhysicalUsagePercentage, StringFormat={}Physical RAM: {0:F1}% used, TargetNullValue=Physical RAM unavailable, FallbackValue=Physical RAM unavailable}" />
                                <TextBlock Text="{Binding Memory.CommitUsagePercentage, StringFormat={}Commit: {0:F1}% used, TargetNullValue=Commit unavailable, FallbackValue=Commit unavailable}" Margin="0,5,0,5" />
                                <TextBlock Text="{Binding Memory.CommitPressureText}" Foreground="#9CA3AF" TextWrapping="Wrap" />
                                <TextBlock Text="Largest measured contributor" Style="{StaticResource MemoryLabel}" Margin="0,8,0,3" />
                                <TextBlock Text="{Binding LargestContributor.ApplicationName, FallbackValue=Unavailable}" Foreground="White" FontWeight="SemiBold" />
                                <WrapPanel Margin="0,4,0,0">
                                    <TextBlock Text="Working Set: " />
                                    <TextBlock Text="{Binding LargestContributor.CombinedWorkingSetBytes, Converter={StaticResource MemoryBytes}, FallbackValue=Unavailable}" />
                                </WrapPanel>
                                <TextBlock Text="WinOptimizer thresholds are not Windows-defined critical boundaries." Foreground="#9CA3AF" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PerformanceCard}" Margin="0,0,12,12" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Startup" FontSize="18" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <TextBlock Text="{Binding StartupCount, StringFormat={}Detected: {0}, TargetNullValue=Detected: unavailable}" />
                                <WrapPanel Margin="0,5,0,5">
                                    <TextBlock Text="{Binding EnabledStartupCount, StringFormat={}Enabled: {0}, TargetNullValue=Enabled: unavailable}" Margin="0,0,12,0" />
                                    <TextBlock Text="{Binding DisabledStartupCount, StringFormat={}Disabled: {0}, TargetNullValue=Disabled: unavailable}" />
                                </WrapPanel>
                                <TextBlock Text="Current memory used by running startup applications" TextWrapping="Wrap" Style="{StaticResource MemoryLabel}" Margin="0,8,0,3" />
                                <TextBlock Text="{Binding StartupMemory.CurrentWorkingSetBytes, Converter={StaticResource MemoryBytes}, FallbackValue=Unavailable}" Foreground="White" FontSize="20" />
                                <TextBlock Text="Current matched working sets, not guaranteed savings." TextWrapping="Wrap" FontSize="11" Foreground="#9CA3AF" Margin="0,5,0,0" />
                                <Button Content="View Startup" Tag="{x:Static views:PerformanceSection.Startup}" Click="NavigatePerformance_Click" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="10,6" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource PerformanceCard}" Margin="0,0,0,12" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Processes" FontSize="18" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,8" />
                                <TextBlock Text="{Binding ProcessCount, StringFormat={}Running processes: {0}, TargetNullValue=Running processes: unavailable}" />
                                <TextBlock Text="{Binding LargestContributor.ApplicationName, StringFormat={}Largest: {0}, FallbackValue=Largest: unavailable}" Margin="0,6,0,6" />
                                <TextBlock Text="Top application Working Sets" Style="{StaticResource MemoryLabel}" />
                                <ItemsControl ItemsSource="{Binding TopApplications}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,4">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding CombinedWorkingSetBytes, Converter={StaticResource MemoryBytes}}" Margin="12,0,0,0" />
                                                <TextBlock Text="{Binding ApplicationName}" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="Working sets can share pages; totals may be partial." Foreground="#9CA3AF" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" />
                                <Button Content="View Processes" Tag="{x:Static views:PerformanceSection.Processes}" Click="NavigatePerformance_Click" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="10,6" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="MemorySection" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Border Background="#1F2937" CornerRadius="12" Padding="20">
                    <StackPanel>
                        <DockPanel>
                            <Button x:Name="RefreshMemoryButton" DockPanel.Dock="Right" Content="Refresh" Padding="16,9" Click="RefreshMemory_Click" />
                            <TextBlock Text="Memory Analyzer" Foreground="White" FontSize="22" FontWeight="SemiBold" />
                        </DockPanel>
                        <TextBlock Text="A read-only snapshot of RAM and process memory. Refresh to update." Foreground="#9CA3AF" Margin="0,6,0,12" TextWrapping="Wrap" />
                        <TextBlock x:Name="MemoryStatusText" Text="Waiting for startup information..." Foreground="#9CA3AF" Margin="0,0,0,12" TextWrapping="Wrap" />
                        <ProgressBar x:Name="MemoryBusyBar" IsIndeterminate="True" Height="4" Visibility="Collapsed" Margin="0,0,0,12" />
                        <StackPanel x:Name="MemorySummaryPanel">
                            <UniformGrid Columns="3">
                                <StackPanel>
                                    <TextBlock Text="Installed RAM" Style="{StaticResource MemoryLabel}" />
                                    <TextBlock Text="{Binding InstalledBytes, Converter={StaticResource MemoryBytes}, FallbackValue=Unavailable}" Style="{StaticResource MemoryValue}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Total usable RAM" Style="{StaticResource MemoryLabel}" />
                                    <TextBlock Text="{Binding TotalBytes, Converter={StaticResource MemoryBytes}, FallbackValue=Unavailable}" Style="{StaticResource MemoryValue}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Physical RAM usage" Style="{StaticResource MemoryLabel}" />
                                    <TextBlock Text="{Binding PhysicalUsagePercentage, StringFormat={}{0:F1}% used, TargetNullValue=Unavailable, FallbackValue=Unavailable}" Style="{StaticResource MemoryValue}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Used RAM" Style="{StaticResource MemoryLabel}" />
                                    <TextBlock Text="{Binding UsedBytes, Converter={StaticResource MemoryBytes}, FallbackValue=Unavailable}" Style="{StaticResource MemoryValue}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Available RAM" Style="{StaticResource MemoryLabel}" />
                                    <TextBlock Text="{Binding AvailableBytes, Converter={StaticResource MemoryBytes}, FallbackValue=Unavailable}" Style="{StaticResource MemoryValue}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="System cache (includes standby)" Style="{StaticResource MemoryLabel}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding CachedBytes, Converter={StaticResource MemoryBytes}, FallbackValue=Unavailable}" Style="{StaticResource MemoryValue}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="System commit usage" Style="{StaticResource MemoryLabel}" />
                                    <TextBlock Text="{Binding CommitUsageBytes, Converter={StaticResource MemoryBytes}, FallbackValue=Unavailable}" Style="{StaticResource MemoryValue}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Commit limit" Style="{StaticResource MemoryLabel}" />
                                    <TextBlock Text="{Binding CommitLimitBytes, Converter={StaticResource MemoryBytes}, FallbackValue=Unavailable}" Style="{StaticResource MemoryValue}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Memory compression" Style="{StaticResource MemoryLabel}" />
                                    <TextBlock Text="{Binding CompressedBytes, Converter={StaticResource MemoryBytes}, FallbackValue=Unavailable}" Style="{StaticResource MemoryValue}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Page files: allocated size" Style="{StaticResource MemoryLabel}" />
                                    <TextBlock Text="{Binding PageFileTotalBytes, Converter={StaticResource MemoryBytes}, FallbackValue=Unavailable}" Style="{StaticResource MemoryValue}" />
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Page files: current usage" Style="{StaticResource MemoryLabel}" />
                                    <TextBlock Text="{Binding PageFileUsedBytes, Converter={StaticResource MemoryBytes}, FallbackValue=Unavailable}" Style="{StaticResource MemoryValue}" />
                                </StackPanel>
                            </UniformGrid>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="Commit usage percentage" Style="{StaticResource MemoryLabel}" />
                                <TextBlock Text="{Binding CommitUsagePercentage, StringFormat={}{0:F1}%, TargetNullValue=Unavailable, FallbackValue=Unavailable}" Style="{StaticResource MemoryValue}" />
                                <TextBlock Text="{Binding CommitPressureText}" TextWrapping="Wrap">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#CBD5E1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCommitNearLimit}" Value="True">
                                                    <Setter Property="Foreground" Value="#FBBF24" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Foreground="#9CA3AF" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" Text="Windows can reclaim cached memory when applications need it. Available RAM includes standby memory. The system cache includes standby plus the system working set, so it overlaps available and used RAM; do not add these figures together. Cache is not wasted RAM." />
                        <TextBlock Foreground="#9CA3AF" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" Text="Commit is memory Windows has promised to back with RAM or page files. Compression and a separate exact reclaimable-memory total are unavailable from the query APIs used here. Unavailable readings are not zero." />
                        <TextBlock Text="The commit warning threshold is defined by WinOptimizer, not by Windows. It does not classify cached RAM as wasted." Foreground="#9CA3AF" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </ScrollViewer>
            <Grid x:Name="ProcessesSection" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition>
                        <RowDefinition.Style>
                            <Style TargetType="RowDefinition">
                                <Setter Property="Height" Value="Auto" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsExpanded, ElementName=DetailedProcessesExpander}" Value="True">
                                        <Setter Property="Height" Value="*" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </RowDefinition.Style>
                    </RowDefinition>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,8" Grid.Row="0">
                    <Button Content="Refresh Processes" DockPanel.Dock="Right" Click="RefreshMemory_Click" IsEnabled="{Binding IsEnabled, ElementName=RefreshMemoryButton}" />
                    <TextBlock Text="Memory Pressure Contributors" FontSize="20" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                </DockPanel>
                <Border Background="#111827" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,8" Grid.Row="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsExpanded, ElementName=DetailedProcessesExpander}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel x:Name="LargestContributorPanel" ToolTip="{Binding ExecutablePath}">
                        <TextBlock Text="Largest current contributor · by combined Working Set" Foreground="#CBD5E1" TextWrapping="Wrap" />
                        <WrapPanel Margin="0,4,0,3">
                            <TextBlock Text="{Binding ApplicationName, FallbackValue=No measured contributor available}" Foreground="White" FontSize="16" FontWeight="SemiBold" Margin="0,0,18,0" ToolTip="{Binding ExecutablePath}" VerticalAlignment="Center" />
                            <TextBlock Text="Working Set: " Foreground="#CBD5E1" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CombinedWorkingSetBytes, Converter={StaticResource MemoryBytes}, FallbackValue=Unavailable}" Foreground="White" Margin="0,0,20,0" VerticalAlignment="Center" />
                            <TextBlock Text="Private Memory: " Foreground="#CBD5E1" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding CombinedPrivateMemoryBytes, Converter={StaticResource MemoryBytes}, FallbackValue=Unavailable}" Foreground="White" VerticalAlignment="Center" />
                        </WrapPanel>
                        <TextBlock Text="{Binding MeasurementStatus}" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0" FontSize="11" />
                    </StackPanel>
                </Border>
                <WrapPanel Margin="0,0,0,8" Grid.Row="2">
                    <TextBlock Text="Sort applications by" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="ContributorSort" SelectedIndex="0" Width="210" Margin="0,0,12,0" SelectionChanged="ContributorSort_Changed">
                        <ComboBoxItem Content="Combined Working Set" />
                        <ComboBoxItem Content="Combined Private Memory" />
                        <ComboBoxItem Content="Process count" />
                        <ComboBoxItem Content="Application name" />
                    </ComboBox>
                    <Button Content="Open Task Manager" Click="OpenMemoryTaskManager_Click" Padding="12,6" />
                </WrapPanel>
                <TextBlock x:Name="ContributorStatusText" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,0,0,8" Grid.Row="3" />
                <TreeView x:Name="MemoryContributorsTree" Background="#111827" Foreground="#CBD5E1" BorderBrush="#374151" ScrollViewer.CanContentScroll="True" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" Grid.Row="4">
                    <TreeView.Resources>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="Foreground" Value="#CBD5E1" />
                            <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True" />
                            <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling" />
                        </Style>
                        <HierarchicalDataTemplate DataType="{x:Type models:MemoryApplicationGroup}" ItemsSource="{Binding Processes}">
                            <StackPanel Margin="4,8">
                                <WrapPanel>
                                    <TextBlock Text="{Binding ApplicationName}" Foreground="White" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ProcessCount, StringFormat={} · {0} processes}" VerticalAlignment="Center" />
                                </WrapPanel>
                                <WrapPanel Margin="0,5">
                                    <TextBlock Text="Working Set: " />
                                    <TextBlock Text="{Binding CombinedWorkingSetBytes, Converter={StaticResource MemoryBytes}}" Margin="0,0,16,0" />
                                    <TextBlock Text="Private Memory: " />
                                    <TextBlock Text="{Binding CombinedPrivateMemoryBytes, Converter={StaticResource MemoryBytes}}" />
                                </WrapPanel>
                                <TextBlock Text="{Binding MeasurementStatus}" Foreground="#9CA3AF" />
                                <TextBlock Text="{Binding StartupAssociation, StringFormat={}Startup: {0}}" Foreground="#9CA3AF" />
                                <TextBlock Text="{Binding ExecutablePath, TargetNullValue=Executable path unavailable}" Foreground="#9CA3AF" FontSize="11" />
                                <Button Content="Open Process Location" Tag="{Binding}" IsEnabled="{Binding CanOpenLocation}" Click="OpenProcessLocation_Click" HorizontalAlignment="Left" Padding="8,4" Margin="0,6,0,0" />
                            </StackPanel>
                        </HierarchicalDataTemplate>
                        <DataTemplate DataType="{x:Type models:ProcessMemoryInfo}">
                            <StackPanel Margin="4,5">
                                <WrapPanel>
                                    <TextBlock Text="{Binding ProcessName}" Margin="0,0,12,0" />
                                    <TextBlock Text="{Binding ProcessId, StringFormat={}PID: {0}}" />
                                </WrapPanel>
                                <WrapPanel Margin="0,4">
                                    <TextBlock Text="Working Set: " />
                                    <TextBlock Text="{Binding WorkingSetBytes, Converter={StaticResource MemoryBytes}}" Margin="0,0,16,0" />
                                    <TextBlock Text="Private Memory: " />
                                    <TextBlock Text="{Binding PrivateMemoryBytes, Converter={StaticResource MemoryBytes}}" />
                                </WrapPanel>
                                <WrapPanel>
                                    <Button Content="Copy PID" Tag="{Binding}" Click="CopyMemoryPid_Click" Padding="8,4" Margin="0,0,8,0" />
                                    <Button Content="Open Process Location" Tag="{Binding}" IsEnabled="{Binding CanOpenLocation}" Click="OpenProcessLocation_Click" Padding="8,4" />
                                </WrapPanel>
                            </StackPanel>
                        </DataTemplate>
                    </TreeView.Resources>
                </TreeView>
                <Expander x:Name="DetailedProcessesExpander" Header="Detailed process list" Foreground="#CBD5E1" Margin="0,8,0,0" Grid.Row="5" VerticalContentAlignment="Stretch" VerticalAlignment="Stretch">
                    <DataGrid x:Name="MemoryProcessesGrid" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" Background="#111827" Foreground="#CBD5E1" RowBackground="#111827" AlternatingRowBackground="#1F2937" BorderBrush="#374151" GridLinesVisibility="None" HeadersVisibility="Column" ScrollViewer.CanContentScroll="True">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#374151" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="Padding" Value="8" />
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="6" />
                                <Setter Property="BorderThickness" Value="0" />
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Setter Property="ToolTip" Value="{Binding ExecutablePath, TargetNullValue=Executable path unavailable}" />
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="160" />
                            <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="65" />
                            <DataGridTextColumn Header="Working Set" Binding="{Binding WorkingSetBytes, Converter={StaticResource MemoryBytes}}" Width="110" />
                            <DataGridTextColumn Header="Private Memory" Binding="{Binding PrivateMemoryBytes, Converter={StaticResource MemoryBytes}}" Width="115" />
                            <DataGridTextColumn Header="Access" Binding="{Binding AccessStatus}" Width="130" />
                            <DataGridTextColumn Header="Startup entry (path match)" Binding="{Binding StartupAssociation}" Width="*" MinWidth="210" />
                            <DataGridTemplateColumn Header="Actions" Width="240">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Copy PID" Tag="{Binding}" Click="CopyMemoryPid_Click" Padding="6,3" Margin="0,0,6,0" />
                                            <Button Content="Open Process Location" Tag="{Binding}" IsEnabled="{Binding CanOpenLocation}" Click="OpenProcessLocation_Click" Padding="6,3" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Expander>
                <Expander Header="How to read these measurements" Foreground="#9CA3AF" Margin="0,6,0,0" Grid.Row="6">
                    <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="All measured processes, regardless of startup association. Grouped only by exact full executable path; unavailable paths stay separate by PID. Different executables from the same product remain separate." Foreground="#9CA3AF" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10" />
                            <TextBlock Text="Expand a group to inspect its individual PIDs. Combined working sets can count shared physical pages more than once. Partial totals exclude missing readings, so the largest measured group may not be the actual largest. These measurements are not potential RAM savings." Foreground="#9CA3AF" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,14" />
                            <TextBlock Foreground="#9CA3AF" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0" Text="Working Set is resident physical memory, including shared pages. Private Memory is private commit, which can reside in RAM or page files. Process totals do not equal used RAM: shared pages can repeat, and Windows also uses memory outside process working sets." />
                            <TextBlock Foreground="#9CA3AF" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0" Text="Startup associations match executable paths from the latest startup scan; they do not prove how a process was launched. Shortcuts, relative paths and ambiguous commands are not guessed. Hover over a process for its executable path, if accessible." />
                        </StackPanel>
                    </ScrollViewer>
                </Expander>
            </Grid>
            <Grid x:Name="StartupSection" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,12" Grid.Row="0">
                    <Button x:Name="RefreshStartupButton" Content="Refresh Startup" DockPanel.Dock="Right" Click="RefreshStartup_Click" />
                    <TextBlock Text="Startup Applications" Foreground="White" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <Border Style="{StaticResource PerformanceCard}" Padding="12" Margin="0,0,0,10" Grid.Row="1">
                    <DockPanel>
                        <Button Content="Refresh Memory" DockPanel.Dock="Right" Click="RefreshMemory_Click" IsEnabled="{Binding IsEnabled, ElementName=RefreshMemoryButton}" VerticalAlignment="Center" Margin="12,0,0,0" />
                        <StackPanel x:Name="AdvisorSummaryPanel">
                            <TextBlock Text="Current memory used by running startup applications" Foreground="#CBD5E1" TextWrapping="Wrap" />
                            <WrapPanel Margin="0,4,0,0">
                                <TextBlock Text="{Binding CurrentWorkingSetBytes, Converter={StaticResource MemoryBytes}, FallbackValue=Unavailable}" Foreground="White" FontSize="22" FontWeight="SemiBold" Margin="0,0,18,0" />
                                <WrapPanel VerticalAlignment="Center">
                                    <TextBlock Text="Current combined Private Memory: " Foreground="#9CA3AF" />
                                    <TextBlock Text="{Binding CurrentPrivateMemoryBytes, Converter={StaticResource MemoryBytes}, FallbackValue=Unavailable}" Foreground="#CBD5E1" />
                                </WrapPanel>
                            </WrapPanel>
                        </StackPanel>
                    </DockPanel>
                </Border>
                <WrapPanel Margin="0,0,0,10" Grid.Row="2">
                    <RadioButton x:Name="StartupApplicationsButton" Content="Applications" GroupName="StartupDisplay" Style="{StaticResource PerformanceTabStyle}" Padding="12,8" Click="StartupDisplay_Click" />
                    <RadioButton x:Name="StartupOpportunitiesButton" Content="Memory Optimization Opportunities" GroupName="StartupDisplay" Style="{StaticResource PerformanceTabStyle}" Padding="12,8" Click="StartupDisplay_Click" />
                </WrapPanel>
                <Grid Grid.Row="3">
                    <Grid x:Name="StartupApplicationsPanel">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="StartupCountText" Text="Scanning..." Foreground="#9CA3AF" FontSize="13" Margin="0,5,0,15" Grid.Row="0" />
                        <ScrollViewer x:Name="StartupApplicationsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Grid.Row="1">
                            <StackPanel x:Name="StartupAppsPanel" />
                        </ScrollViewer>
                    </Grid>
                    <Grid x:Name="StartupOpportunitiesPanel" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="AdvisorStatusText" Text="Refresh Memory to collect a current measurement." Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,0,0,6" FontSize="11" Grid.Row="0" />
                        <WrapPanel Margin="0,0,0,6" Grid.Row="1">
                            <TextBlock Text="Show" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="AdvisorFilter" SelectedIndex="0" Margin="0,0,14,0" SelectionChanged="MemoryAdvisorOptions_Changed" Width="280">
                                <ComboBoxItem Content="All running processes" />
                                <ComboBoxItem Content="Running startup applications only" />
                                <ComboBoxItem Content="Processes without startup association" />
                            </ComboBox>
                            <TextBlock Text="Sort by" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="AdvisorSort" SelectedIndex="0" SelectionChanged="MemoryAdvisorOptions_Changed" Margin="0,0,14,0" Width="160">
                                <ComboBoxItem Content="Working Set" />
                                <ComboBoxItem Content="Private Memory" />
                                <ComboBoxItem Content="Process name" />
                            </ComboBox>
                        </WrapPanel>
                        <TextBlock x:Name="AdvisorRowsStatusText" Text="No snapshot yet" Foreground="#9CA3AF" Margin="0,0,0,8" TextWrapping="Wrap" FontSize="11" Grid.Row="2" />
                        <ListBox x:Name="AdvisorRows" Background="#111827" Foreground="#CBD5E1" BorderBrush="#374151" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling" Grid.Row="3">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#374151" BorderThickness="0,0,0,1" Padding="10">
                                        <StackPanel>
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="Manage Startup" Tag="{Binding}" Click="ManageAdvisorStartup_Click" Padding="12,7" Margin="12,0,0,0">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource PerformanceButtonStyle}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding CanManageStartup}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Process.ProcessName}" Foreground="White" FontSize="16" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Process.ProcessId, StringFormat={}PID: {0}}" Foreground="#9CA3AF" FontSize="11" />
                                                </StackPanel>
                                            </DockPanel>
                                            <WrapPanel Margin="0,6,0,5">
                                                <TextBlock Text="Working Set: " />
                                                <TextBlock Text="{Binding Process.WorkingSetBytes, Converter={StaticResource MemoryBytes}}" Margin="0,0,20,0" />
                                                <TextBlock Text="Private Memory: " />
                                                <TextBlock Text="{Binding Process.PrivateMemoryBytes, Converter={StaticResource MemoryBytes}}" />
                                            </WrapPanel>
                                            <TextBlock Text="{Binding Category}" Foreground="#CBD5E1" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding StartupStateText, StringFormat={}Startup: {0}}" Foreground="#9CA3AF" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding StartupSourceText}" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding AdminRequirementText}" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding Process.ExecutablePath, TargetNullValue=Executable path unavailable}" Foreground="#9CA3AF" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Expander Header="About startup opportunities" Foreground="#9CA3AF" Margin="0,8,0,0" Grid.Row="4">
                            <ScrollViewer MaxHeight="130" VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Review running applications and their startup settings using the current Memory Analyzer snapshot." Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,6,0,12" />
                                    <TextBlock Foreground="#9CA3AF" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12" Text="The main total sums measured working sets for unique startup matches, including entries already disabled. Each process is counted once; shared pages may still be counted more than once. Missing readings and ambiguous matches are excluded. These are current measurements, not guaranteed savings after restart. Disabling startup does not close running applications." />
                                    <TextBlock Foreground="#9CA3AF" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,8" Text="Only a single full executable-path match is associated. Similar names, unresolved shortcuts and packaged paths are not guessed. The unassociated filter also includes ambiguous matches. Manage Startup takes you to the existing Applications view, with their confirmation, history and administrator handling. Packaged Startup Tasks remain managed in Windows Settings." />
                                    <Button Content="View Startup Applications" Click="ViewAdvisorStartup_Click" Padding="12,7" HorizontalAlignment="Left" />
                                    <Button Content="Refresh Memory Snapshot" Click="RefreshMemory_Click" IsEnabled="{Binding IsEnabled, ElementName=RefreshMemoryButton}" HorizontalAlignment="Left" />
                                </StackPanel>
                            </ScrollViewer>
                        </Expander>
                    </Grid>
                </Grid>
            </Grid>
            <Grid x:Name="BackgroundSection" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel>
                    <WrapPanel>
                        <TextBlock Text="Background Activity" FontSize="20" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" Margin="0,0,16,8"/>
                        <Button x:Name="RefreshBackgroundButton" Content="Refresh Background" Click="RefreshBackground_Click" Margin="0,0,8,8"/>
                        <Button x:Name="CancelBackgroundButton" Content="Cancel" IsEnabled="False" Click="CancelBackground_Click" Margin="0,0,8,8"/>
                        <Button Content="Windows Services" Click="OpenServicesConsole_Click" Margin="0,0,8,8"/>
                        <Button Content="Task Manager" Click="OpenMemoryTaskManager_Click" Margin="0,0,0,8"/>
                    </WrapPanel>
                    <TextBlock x:Name="BackgroundStatus" Text="Select Refresh Background to collect a read-only snapshot." Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,0,0,8"/>
                </StackPanel>
                <Border Grid.Row="1" Style="{StaticResource PerformanceCard}" Padding="12" Margin="0,0,0,10">
                    <UniformGrid x:Name="BackgroundSummary" Columns="3">
                        <StackPanel><TextBlock Text="Running services" Style="{StaticResource MemoryLabel}"/><TextBlock Text="{Binding RunningServices, FallbackValue=Not measured}" Style="{StaticResource MemoryValue}" Margin="0,4,0,0"/></StackPanel>
                        <StackPanel><TextBlock Text="Measured service host processes" Style="{StaticResource MemoryLabel}" TextWrapping="Wrap"/><TextBlock Text="{Binding ServiceHostProcesses, FallbackValue=Not measured}" Style="{StaticResource MemoryValue}" Margin="0,4,0,0"/></StackPanel>
                        <StackPanel><TextBlock Text="Measured background / host working set" Style="{StaticResource MemoryLabel}" TextWrapping="Wrap"/><TextBlock Text="{Binding MeasuredWorkingSetBytes, Converter={StaticResource MemoryBytes}, FallbackValue=Not measured}" Style="{StaticResource MemoryValue}" Margin="0,4,0,0"/></StackPanel>
                    </UniformGrid>
                </Border>
                <WrapPanel Grid.Row="2" Margin="0,0,0,8">
                    <TextBlock Text="Show" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="BackgroundFilterBox" SelectedIndex="0" SelectionChanged="BackgroundView_Changed" Width="180" Margin="0,0,16,0">
                        <ComboBoxItem Content="All"/><ComboBoxItem Content="Running services"/><ComboBoxItem Content="Automatic services"/><ComboBoxItem Content="Manual services"/>
                    </ComboBox>
                    <TextBlock Text="Sort" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ComboBox x:Name="BackgroundSortBox" SelectedIndex="0" SelectionChanged="BackgroundView_Changed" Width="180">
                        <ComboBoxItem Content="Working Set"/><ComboBoxItem Content="Service/application name"/><ComboBoxItem Content="Startup type"/><ComboBoxItem Content="Process count"/>
                    </ComboBox>
                </WrapPanel>
                <ListBox x:Name="BackgroundList" Grid.Row="3" Background="Transparent" Foreground="#CBD5E1" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" HorizontalContentAlignment="Stretch">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource PerformanceCard}" Padding="12" Margin="0,0,0,8">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" FontSize="16"/>
                                    <WrapPanel Margin="0,4,0,4">
                                        <TextBlock Text="{Binding Process.ProcessId, StringFormat={}PID: {0}, FallbackValue=No measured PID}" Margin="0,0,12,0"/>
                                        <TextBlock Text="{Binding ProcessCount, StringFormat={}Processes: {0}}" Margin="0,0,12,0"/>
                                        <TextBlock Text="Working Set: "/><TextBlock Text="{Binding WorkingSetBytes, Converter={StaticResource MemoryBytes}}" Margin="0,0,12,0"/>
                                        <TextBlock Text="Private: "/><TextBlock Text="{Binding PrivateMemoryBytes, Converter={StaticResource MemoryBytes}}"/>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding Process.ProcessName, StringFormat={}Host/process: {0}, FallbackValue=Host unavailable}" Style="{StaticResource MemoryLabel}"/>
                                    <TextBlock Text="{Binding ServiceState, StringFormat={}State: {0}}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding StartupType, StringFormat={}Service startup: {0}}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Association}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding AccessStatus}" Style="{StaticResource MemoryLabel}" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Process.StartupAssociation, StringFormat={}Startup association: {0}}" Style="{StaticResource MemoryLabel}" TextWrapping="Wrap"/>
                                    <WrapPanel Margin="0,8,0,0">
                                        <Button Content="Open executable location" Tag="{Binding Process}" IsEnabled="{Binding Process.CanOpenLocation, FallbackValue=False}" Click="OpenProcessLocation_Click" Padding="8,5" Margin="0,0,8,0"/>
                                        <Button Content="Copy PID" Tag="{Binding Process}" Click="CopyMemoryPid_Click" Padding="8,5">
                                            <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PerformanceButtonStyle}"><Style.Triggers><DataTrigger Binding="{Binding Process}" Value="{x:Null}"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                        </Button>
                                    </WrapPanel>
                                    <Expander Header="{Binding Services.Count, StringFormat={}Service details ({0})}" Foreground="#CBD5E1" Margin="0,8,0,0">
                                        <ItemsControl ItemsSource="{Binding Services}">
                                            <ItemsControl.ItemTemplate><DataTemplate>
                                                <StackPanel Margin="0,8,0,4">
                                                    <TextBlock Text="{Binding DisplayName}" Foreground="White" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding AccessStatus}" Style="{StaticResource MemoryLabel}"/>
                                                    <TextBlock Text="{Binding Details}" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding ProcessId, StringFormat={}Reported host PID: {0}, TargetNullValue=No reported host PID}" Style="{StaticResource MemoryLabel}"/>
                                                    <TextBlock Text="{Binding Description, TargetNullValue=Description unavailable}" Style="{StaticResource MemoryLabel}" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding ConfiguredCommand, TargetNullValue=Configured command unavailable}" Style="{StaticResource MemoryLabel}" TextWrapping="Wrap"/>
                                                    <Button Content="Copy service name" Tag="{Binding}" Click="CopyServiceName_Click" HorizontalAlignment="Left" Padding="8,5" Margin="0,5,0,0"/>
                                                </StackPanel>
                                            </DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Expander Grid.Row="4" Header="About these measurements and classifications" Foreground="#9CA3AF" Margin="0,8,0,0">
                    <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                        <TextBlock TextWrapping="Wrap" Text="Each sampled PID contributes once, regardless of how many services share it. Host memory cannot be attributed exactly to individual services. Working sets may share physical pages across PIDs. Counts and totals describe the full snapshot, not the filtered list. A filter retains the complete shared host if any hosted service matches. Non-service processes without a detected main window are background candidates; this heuristic does not prove background activity, and unknown window states are included. Service/process samples are not atomic: processes can exit or PIDs can change during collection. Incomplete readings are excluded from memory totals. Publisher origin is Unknown; Microsoft/third-party filters are not offered without verified origin. CPU usage is not measured. Startup and background categories overlap; these totals must not be added to total RAM. System/cache memory is not directly attributable here; Windows can reclaim cached memory. Cancellation is checked between WMI results and process queries; an in-flight WMI request may delay cancellation."/>
                    </ScrollViewer>
                </Expander>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
