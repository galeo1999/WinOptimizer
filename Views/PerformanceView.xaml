<UserControl x:Class="WinOptimizer.Views.PerformanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:WinOptimizer.Models"
             xmlns:views="clr-namespace:WinOptimizer.Views"
             Unloaded="PerformanceMemory_Unloaded"
             Background="#111827">
    <UserControl.Resources>
        <views:MemoryBytesConverter x:Key="MemoryBytes"/>
        <Style x:Key="MemoryLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#9CA3AF"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="MemoryValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="Margin" Value="0,4,10,14"/>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <Grid Margin="30">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->

            <StackPanel Grid.Row="0">

                <TextBlock Text="Performance"
                           Foreground="White"
                           FontSize="28"
                           FontWeight="Bold"/>

                <TextBlock Text="Startup and background performance analysis"
                           Foreground="#9CA3AF"
                           FontSize="14"
                           Margin="0,5,0,0"/>

            </StackPanel>

            <Border Grid.Row="2" Background="#1F2937" CornerRadius="12" Padding="20">
                <StackPanel>
                    <DockPanel>
                        <Button x:Name="RefreshMemoryButton" DockPanel.Dock="Right" Content="Refresh" Padding="16,9"
                                Click="RefreshMemory_Click"/>
                        <TextBlock Text="Memory Analyzer" Foreground="White" FontSize="22" FontWeight="SemiBold"/>
                    </DockPanel>
                    <TextBlock Text="A read-only snapshot of RAM and process memory. Refresh to update."
                               Foreground="#9CA3AF" Margin="0,6,0,12" TextWrapping="Wrap"/>
                    <TextBlock x:Name="MemoryStatusText" Text="Waiting for startup information..."
                               Foreground="#9CA3AF" Margin="0,0,0,12" TextWrapping="Wrap"/>
                    <ProgressBar x:Name="MemoryBusyBar" IsIndeterminate="True" Height="4" Visibility="Collapsed" Margin="0,0,0,12"/>
                    <StackPanel x:Name="MemorySummaryPanel">
                        <UniformGrid Columns="3">
                            <StackPanel>
                                <TextBlock Text="Installed RAM" Style="{StaticResource MemoryLabel}"/>
                                <TextBlock Text="{Binding InstalledBytes, Converter={StaticResource MemoryBytes}, FallbackValue=Unavailable}" Style="{StaticResource MemoryValue}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Total usable RAM" Style="{StaticResource MemoryLabel}"/>
                                <TextBlock Text="{Binding TotalBytes, Converter={StaticResource MemoryBytes}, FallbackValue=Unavailable}" Style="{StaticResource MemoryValue}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Physical RAM usage" Style="{StaticResource MemoryLabel}"/>
                                <TextBlock Text="{Binding PhysicalUsagePercentage, StringFormat={}{0:F1}% used, TargetNullValue=Unavailable, FallbackValue=Unavailable}" Style="{StaticResource MemoryValue}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Used RAM" Style="{StaticResource MemoryLabel}"/>
                                <TextBlock Text="{Binding UsedBytes, Converter={StaticResource MemoryBytes}, FallbackValue=Unavailable}" Style="{StaticResource MemoryValue}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Available RAM" Style="{StaticResource MemoryLabel}"/>
                                <TextBlock Text="{Binding AvailableBytes, Converter={StaticResource MemoryBytes}, FallbackValue=Unavailable}" Style="{StaticResource MemoryValue}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="System cache (includes standby)" Style="{StaticResource MemoryLabel}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding CachedBytes, Converter={StaticResource MemoryBytes}, FallbackValue=Unavailable}" Style="{StaticResource MemoryValue}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="System commit usage" Style="{StaticResource MemoryLabel}"/>
                                <TextBlock Text="{Binding CommitUsageBytes, Converter={StaticResource MemoryBytes}, FallbackValue=Unavailable}" Style="{StaticResource MemoryValue}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Commit limit" Style="{StaticResource MemoryLabel}"/>
                                <TextBlock Text="{Binding CommitLimitBytes, Converter={StaticResource MemoryBytes}, FallbackValue=Unavailable}" Style="{StaticResource MemoryValue}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Memory compression" Style="{StaticResource MemoryLabel}"/>
                                <TextBlock Text="{Binding CompressedBytes, Converter={StaticResource MemoryBytes}, FallbackValue=Unavailable}" Style="{StaticResource MemoryValue}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Page files: allocated size" Style="{StaticResource MemoryLabel}"/>
                                <TextBlock Text="{Binding PageFileTotalBytes, Converter={StaticResource MemoryBytes}, FallbackValue=Unavailable}" Style="{StaticResource MemoryValue}"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Page files: current usage" Style="{StaticResource MemoryLabel}"/>
                                <TextBlock Text="{Binding PageFileUsedBytes, Converter={StaticResource MemoryBytes}, FallbackValue=Unavailable}" Style="{StaticResource MemoryValue}"/>
                            </StackPanel>
                        </UniformGrid>
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Commit usage percentage" Style="{StaticResource MemoryLabel}"/>
                            <TextBlock Text="{Binding CommitUsagePercentage, StringFormat={}{0:F1}%, TargetNullValue=Unavailable, FallbackValue=Unavailable}"
                                       Style="{StaticResource MemoryValue}"/>
                            <TextBlock Text="{Binding CommitPressureText}" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#CBD5E1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCommitNearLimit}" Value="True">
                                                <Setter Property="Foreground" Value="#FBBF24"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Foreground="#9CA3AF" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="Windows can reclaim cached memory when applications need it. Available RAM includes standby memory. The system cache includes standby plus the system working set, so it overlaps available and used RAM; do not add these figures together. Cache is not wasted RAM."/>
                    <TextBlock Foreground="#9CA3AF" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="Commit is memory Windows has promised to back with RAM or page files. Compression and a separate exact reclaimable-memory total are unavailable from the query APIs used here. Unavailable readings are not zero."/>
                    <TextBlock Text="Memory Pressure Contributors" Foreground="White" FontSize="20" FontWeight="SemiBold" Margin="0,12,0,8"/>
                    <TextBlock Text="All measured processes, regardless of startup association. Grouped only by exact full executable path; unavailable paths stay separate by PID. Different executables from the same product remain separate."
                               Foreground="#9CA3AF" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,10"/>
                    <Border Background="#111827" BorderBrush="#374151" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12">
                        <StackPanel x:Name="LargestContributorPanel">
                            <TextBlock Text="Largest current contributor · by combined Working Set" Foreground="#CBD5E1" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding ApplicationName, FallbackValue=No measured contributor available}" Foreground="White" FontSize="20" FontWeight="SemiBold" Margin="0,5"/>
                            <TextBlock Text="{Binding ExecutablePath}" Foreground="#9CA3AF" FontSize="11" TextWrapping="Wrap"/>
                            <WrapPanel Margin="0,6,0,0">
                                <TextBlock Text="Working Set: " Foreground="#CBD5E1"/>
                                <TextBlock Text="{Binding CombinedWorkingSetBytes, Converter={StaticResource MemoryBytes}, FallbackValue=Unavailable}" Foreground="White" Margin="0,0,20,0"/>
                                <TextBlock Text="Private Memory: " Foreground="#CBD5E1"/>
                                <TextBlock Text="{Binding CombinedPrivateMemoryBytes, Converter={StaticResource MemoryBytes}, FallbackValue=Unavailable}" Foreground="White"/>
                            </WrapPanel>
                            <TextBlock Text="{Binding MeasurementStatus}" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Border>
                    <WrapPanel Margin="0,0,0,10">
                        <TextBlock Text="Sort applications by" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="ContributorSort" SelectedIndex="0" Width="210" Margin="0,0,12,0" SelectionChanged="ContributorSort_Changed">
                            <ComboBoxItem Content="Combined Working Set"/>
                            <ComboBoxItem Content="Combined Private Memory"/>
                            <ComboBoxItem Content="Process count"/>
                            <ComboBoxItem Content="Application name"/>
                        </ComboBox>
                        <Button Content="Open Task Manager" Click="OpenMemoryTaskManager_Click" Padding="12,6"/>
                    </WrapPanel>
                    <TextBlock x:Name="ContributorStatusText" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TreeView x:Name="MemoryContributorsTree" Height="350" Background="#111827" Foreground="#CBD5E1" BorderBrush="#374151"
                              ScrollViewer.CanContentScroll="True" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <TreeView.Resources>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="Foreground" Value="#CBD5E1"/>
                                <Setter Property="VirtualizingStackPanel.IsVirtualizing" Value="True"/>
                                <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling"/>
                            </Style>
                            <HierarchicalDataTemplate DataType="{x:Type models:MemoryApplicationGroup}" ItemsSource="{Binding Processes}">
                                <StackPanel Margin="4,8">
                                    <WrapPanel>
                                        <TextBlock Text="{Binding ApplicationName}" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding ProcessCount, StringFormat={} · {0} processes}" VerticalAlignment="Center"/>
                                    </WrapPanel>
                                    <WrapPanel Margin="0,5">
                                        <TextBlock Text="Working Set: "/>
                                        <TextBlock Text="{Binding CombinedWorkingSetBytes, Converter={StaticResource MemoryBytes}}" Margin="0,0,16,0"/>
                                        <TextBlock Text="Private Memory: "/>
                                        <TextBlock Text="{Binding CombinedPrivateMemoryBytes, Converter={StaticResource MemoryBytes}}"/>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding MeasurementStatus}" Foreground="#9CA3AF"/>
                                    <TextBlock Text="{Binding StartupAssociation, StringFormat={}Startup: {0}}" Foreground="#9CA3AF"/>
                                    <TextBlock Text="{Binding ExecutablePath, TargetNullValue=Executable path unavailable}" Foreground="#9CA3AF" FontSize="11"/>
                                    <Button Content="Open Process Location" Tag="{Binding}" IsEnabled="{Binding CanOpenLocation}"
                                            Click="OpenProcessLocation_Click" HorizontalAlignment="Left" Padding="8,4" Margin="0,6,0,0"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                            <DataTemplate DataType="{x:Type models:ProcessMemoryInfo}">
                                <StackPanel Margin="4,5">
                                    <WrapPanel>
                                        <TextBlock Text="{Binding ProcessName}" Margin="0,0,12,0"/>
                                        <TextBlock Text="{Binding ProcessId, StringFormat={}PID: {0}}"/>
                                    </WrapPanel>
                                    <WrapPanel Margin="0,4">
                                        <TextBlock Text="Working Set: "/>
                                        <TextBlock Text="{Binding WorkingSetBytes, Converter={StaticResource MemoryBytes}}" Margin="0,0,16,0"/>
                                        <TextBlock Text="Private Memory: "/>
                                        <TextBlock Text="{Binding PrivateMemoryBytes, Converter={StaticResource MemoryBytes}}"/>
                                    </WrapPanel>
                                    <WrapPanel>
                                        <Button Content="Copy PID" Tag="{Binding}" Click="CopyMemoryPid_Click" Padding="8,4" Margin="0,0,8,0"/>
                                        <Button Content="Open Process Location" Tag="{Binding}" IsEnabled="{Binding CanOpenLocation}" Click="OpenProcessLocation_Click" Padding="8,4"/>
                                    </WrapPanel>
                                </StackPanel>
                            </DataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                    <TextBlock Text="Expand a group to inspect its individual PIDs. Combined working sets can count shared physical pages more than once. Partial totals exclude missing readings, so the largest measured group may not be the actual largest. These measurements are not potential RAM savings."
                               Foreground="#9CA3AF" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,14"/>
                    <TextBlock Text="Processes · largest working sets first" Foreground="White" FontSize="16" Margin="0,4,0,8"/>
                    <DataGrid x:Name="MemoryProcessesGrid" Height="360" IsReadOnly="True" AutoGenerateColumns="False"
                              CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True"
                              Background="#111827" Foreground="#CBD5E1" RowBackground="#111827" AlternatingRowBackground="#1F2937"
                              BorderBrush="#374151" GridLinesVisibility="None" HeadersVisibility="Column"
                              ScrollViewer.CanContentScroll="True">
                        <DataGrid.Resources>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#374151"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="Padding" Value="8"/>
                            </Style>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="6"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                            <Style TargetType="DataGridRow">
                                <Setter Property="ToolTip" Value="{Binding ExecutablePath, TargetNullValue=Executable path unavailable}"/>
                            </Style>
                        </DataGrid.Resources>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="160"/>
                            <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="65"/>
                            <DataGridTextColumn Header="Working Set" Binding="{Binding WorkingSetBytes, Converter={StaticResource MemoryBytes}}" Width="110"/>
                            <DataGridTextColumn Header="Private Memory" Binding="{Binding PrivateMemoryBytes, Converter={StaticResource MemoryBytes}}" Width="115"/>
                            <DataGridTextColumn Header="Access" Binding="{Binding AccessStatus}" Width="130"/>
                            <DataGridTextColumn Header="Startup entry (path match)" Binding="{Binding StartupAssociation}" Width="*" MinWidth="210"/>
                            <DataGridTemplateColumn Header="Actions" Width="240">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Copy PID" Tag="{Binding}" Click="CopyMemoryPid_Click" Padding="6,3" Margin="0,0,6,0"/>
                                            <Button Content="Open Process Location" Tag="{Binding}" IsEnabled="{Binding CanOpenLocation}" Click="OpenProcessLocation_Click" Padding="6,3"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Foreground="#9CA3AF" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,0"
                               Text="Working Set is resident physical memory, including shared pages. Private Memory is private commit, which can reside in RAM or page files. Process totals do not equal used RAM: shared pages can repeat, and Windows also uses memory outside process working sets."/>
                    <TextBlock Foreground="#9CA3AF" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="Startup associations match executable paths from the latest startup scan; they do not prove how a process was launched. Shortcuts, relative paths and ambiguous commands are not guessed. Hover over a process for its executable path, if accessible."/>
                </StackPanel>
            </Border>

            <Border Grid.Row="4" Background="#1F2937" CornerRadius="12" Padding="20">
                <StackPanel>
                    <TextBlock Text="Memory Optimization Opportunities" Foreground="White" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="Review running applications and their startup settings using the current Memory Analyzer snapshot."
                               Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,6,0,12"/>
                    <StackPanel x:Name="AdvisorSummaryPanel">
                        <TextBlock Text="Current memory used by running startup applications" Foreground="#CBD5E1" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding CurrentWorkingSetBytes, Converter={StaticResource MemoryBytes}, FallbackValue=Unavailable}"
                                   Foreground="White" FontSize="26" FontWeight="SemiBold" Margin="0,5,0,5"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Current combined Private Memory: " Foreground="#9CA3AF"/>
                            <TextBlock Text="{Binding CurrentPrivateMemoryBytes, Converter={StaticResource MemoryBytes}, FallbackValue=Unavailable}" Foreground="#CBD5E1"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="AdvisorStatusText" Text="Refresh Memory to collect a current measurement."
                               Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,10,0,8"/>
                    <TextBlock Foreground="#9CA3AF" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"
                               Text="The main total sums measured working sets for unique startup matches, including entries already disabled. Each process is counted once; shared pages may still be counted more than once. Missing readings and ambiguous matches are excluded. These are current measurements, not guaranteed savings after restart. Disabling startup does not close running applications."/>
                    <WrapPanel Margin="0,0,0,10">
                        <TextBlock Text="Show" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="AdvisorFilter" SelectedIndex="0" Width="280" Margin="0,0,16,0"
                                  SelectionChanged="MemoryAdvisorOptions_Changed">
                            <ComboBoxItem Content="All running processes"/>
                            <ComboBoxItem Content="Running startup applications only"/>
                            <ComboBoxItem Content="Processes without startup association"/>
                        </ComboBox>
                        <TextBlock Text="Sort by" Foreground="#CBD5E1" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox x:Name="AdvisorSort" SelectedIndex="0" Width="160" SelectionChanged="MemoryAdvisorOptions_Changed">
                            <ComboBoxItem Content="Working Set"/>
                            <ComboBoxItem Content="Private Memory"/>
                            <ComboBoxItem Content="Process name"/>
                        </ComboBox>
                    </WrapPanel>
                    <TextBlock x:Name="AdvisorRowsStatusText" Text="No snapshot yet" Foreground="#9CA3AF" Margin="0,0,0,8"/>
                    <ListBox x:Name="AdvisorRows" Height="380" Background="#111827" Foreground="#CBD5E1"
                             BorderBrush="#374151" HorizontalContentAlignment="Stretch"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                             VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#374151" BorderThickness="0,0,0,1" Padding="10">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Manage Startup" Tag="{Binding}"
                                                    Click="ManageAdvisorStartup_Click" Padding="12,7" Margin="12,0,0,0">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CanManageStartup}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Process.ProcessName}" Foreground="White" FontSize="16" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Process.ProcessId, StringFormat={}PID: {0}}" Foreground="#9CA3AF" FontSize="11"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <WrapPanel Margin="0,6,0,5">
                                            <TextBlock Text="Working Set: " />
                                            <TextBlock Text="{Binding Process.WorkingSetBytes, Converter={StaticResource MemoryBytes}}" Margin="0,0,20,0"/>
                                            <TextBlock Text="Private Memory: "/>
                                            <TextBlock Text="{Binding Process.PrivateMemoryBytes, Converter={StaticResource MemoryBytes}}"/>
                                        </WrapPanel>
                                        <TextBlock Text="{Binding Category}" Foreground="#CBD5E1" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding StartupStateText, StringFormat={}Startup: {0}}" Foreground="#9CA3AF" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding StartupSourceText}" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding AdminRequirementText}" Foreground="#9CA3AF" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                        <TextBlock Text="{Binding Process.ExecutablePath, TargetNullValue=Executable path unavailable}" Foreground="#9CA3AF"
                                                   FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Foreground="#9CA3AF" FontSize="12" TextWrapping="Wrap" Margin="0,10,0,8"
                               Text="Only a single full executable-path match is associated. Similar names, unresolved shortcuts and packaged paths are not guessed. The unassociated filter also includes ambiguous matches. Manage Startup takes you to the existing controls below, with their confirmation, history and administrator handling. Packaged Startup Tasks remain managed in Windows Settings."/>
                    <Button Content="View Startup Applications" Click="ViewAdvisorStartup_Click" Padding="12,7" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <!-- Startup Section -->

            <StackPanel Grid.Row="6">

                <TextBlock Text="Startup Applications"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="SemiBold"/>

                <TextBlock x:Name="StartupCountText"
                           Text="Scanning..."
                           Foreground="#9CA3AF"
                           FontSize="13"
                           Margin="0,5,0,15"/>

                <StackPanel x:Name="StartupAppsPanel"/>

            </StackPanel>

        </Grid>

    </ScrollViewer>

</UserControl>