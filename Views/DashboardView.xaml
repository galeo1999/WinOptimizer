<UserControl x:Class="WinOptimizer.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#111827">
    <UserControl.Resources>

        <Style x:Key="ModernProgressBarStyle"
               TargetType="ProgressBar">

            <Setter Property="Height"
                    Value="14"/>

            <Setter Property="Background"
                    Value="#334155"/>

            <Setter Property="Foreground"
                    Value="#22C55E"/>

            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="ProgressBar">

                        <Grid x:Name="PART_Track"
                              ClipToBounds="True">

                            <!-- Hintergrund -->
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="7"/>

                            <!-- Fortschritt -->
                            <Border x:Name="PART_Indicator"
                                    Background="{TemplateBinding Foreground}"
                                    HorizontalAlignment="Left"
                                    CornerRadius="7"/>

                        </Grid>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <!-- ScrollViewer hat genau EIN direktes Child -->
        <Grid Margin="25">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===================================================== -->
            <!-- Header -->
            <!-- ===================================================== -->

            <StackPanel Grid.Row="0">

                <TextBlock Text="Dashboard"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="White"/>

                <TextBlock Text="System overview"
                           FontSize="14"
                           Foreground="#9CA3AF"
                           Margin="0,5,0,0"/>

            </StackPanel>

            <!-- ===================================================== -->
            <!-- Hardware Cards -->
            <!-- ===================================================== -->

            <Grid Grid.Row="2">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="15"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Windows -->

                <Border Grid.Row="0"
                        Grid.Column="0"
                        Background="#1F2937"
                        CornerRadius="12"
                        Padding="20">

                    <StackPanel>

                        <TextBlock Text="Windows"
                                   Foreground="#9CA3AF"
                                   FontSize="13"/>

                        <TextBlock x:Name="WindowsVersionText"
                                   Text="Loading..."
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"/>

                    </StackPanel>

                </Border>

                <!-- CPU -->

                <Border Grid.Row="0"
                        Grid.Column="2"
                        Background="#1F2937"
                        CornerRadius="12"
                        Padding="20">

                    <StackPanel>

                        <TextBlock Text="CPU"
                                   Foreground="#9CA3AF"
                                   FontSize="13"/>

                        <TextBlock x:Name="CpuText"
                                   Text="Loading..."
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"/>
                        <ProgressBar x:Name="CpuProgressBar"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0"
                                     Style="{StaticResource ModernProgressBarStyle}"
                                     Margin="0,15,0,0"/>

                        <TextBlock x:Name="CpuPercentText"
                                   Text="0 % in use"
                                   Foreground="#9CA3AF"
                                   FontSize="13"
                                   Margin="0,8,0,0"/>

                    </StackPanel>

                </Border>

                <!-- GPU -->

                <Border Grid.Row="0"
                        Grid.Column="4"
                        Background="#1F2937"
                        CornerRadius="12"
                        Padding="20">

                    <StackPanel>

                        <TextBlock Text="GPU"
                                   Foreground="#9CA3AF"
                                   FontSize="13"/>

                        <TextBlock x:Name="GpuText"
                                   Text="Loading..."
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"/>

                    </StackPanel>

                </Border>

                <!-- Motherboard -->

                <Border Grid.Row="2"
                        Grid.Column="0"
                        Background="#1F2937"
                        CornerRadius="12"
                        Padding="20">

                    <StackPanel>

                        <TextBlock Text="Motherboard"
                                   Foreground="#9CA3AF"
                                   FontSize="13"/>

                        <TextBlock x:Name="MotherboardText"
                                   Text="Loading..."
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,8,0,0"
                                   TextWrapping="Wrap"/>

                    </StackPanel>

                </Border>

                <!-- BIOS -->

                <Border Grid.Row="2"
                        Grid.Column="2"
                        Background="#1F2937"
                        CornerRadius="12"
                        Padding="20">

                    <StackPanel>

                        <TextBlock Text="BIOS"
                                   Foreground="#9CA3AF"
                                   FontSize="13"/>

                        <TextBlock x:Name="BiosText"
                                   Text="Loading..."
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,8,0,0"/>

                    </StackPanel>

                </Border>

                <!-- System Drive -->

                <Border Grid.Row="2"
                        Grid.Column="4"
                        Background="#1F2937"
                        CornerRadius="12"
                        Padding="20">

                    <StackPanel>

                        <TextBlock Text="System Drive"
                                   Foreground="#9CA3AF"
                                   FontSize="13"/>

                        <TextBlock x:Name="SystemDriveText"
                                   Text="Loading..."
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,8,0,0"/>

                    </StackPanel>

                </Border>

            </Grid>

            <!-- ===================================================== -->
            <!-- RAM + Physical Storage -->
            <!-- ===================================================== -->

            <Grid Grid.Row="4">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <!-- RAM -->

                <Border Grid.Column="0"
                        Background="#1F2937"
                        CornerRadius="12"
                        Padding="20">

                    <StackPanel>

                        <TextBlock Text="Memory"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="SemiBold"/>

                        <TextBlock x:Name="RamDetailsText"
                                   Text="Loading..."
                                   Foreground="#D1D5DB"
                                   FontSize="14"
                                   Margin="0,18,0,12"/>

                        <ProgressBar x:Name="RamProgressBar"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0"
                                     Style="{StaticResource ModernProgressBarStyle}"/>

                        <TextBlock x:Name="RamPercentText"
                                   Text="0 %"
                                   Foreground="#9CA3AF"
                                   FontSize="13"
                                   Margin="0,10,0,0"/>

                    </StackPanel>

                </Border>

                <!-- Physical Storage -->

                <Border Grid.Column="2"
                        Background="#1F2937"
                        CornerRadius="12"
                        Padding="20">

                    <StackPanel>

                        <TextBlock Text="Physical Storage"
                                   Foreground="White"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,15"/>

                        <StackPanel x:Name="PhysicalDrivesPanel"/>

                    </StackPanel>

                </Border>

            </Grid>

            <!-- ===================================================== -->
            <!-- Volumes -->
            <!-- ===================================================== -->

            <Border Grid.Row="6"
                    Background="#1F2937"
                    CornerRadius="12"
                    Padding="20">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="15"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="Volumes"
                               Foreground="White"
                               FontSize="18"
                               FontWeight="SemiBold"/>
<StackPanel x:Name="VolumesPanel"
            Grid.Row="2"/>

                </Grid>

            </Border>

        </Grid>

    </ScrollViewer>

</UserControl>