<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <!-- Compile the production transaction code directly to exercise internal adapters without exposing them publicly. -->
  <ItemGroup>
    <Compile Include="../../Models/BackgroundServiceChange.cs" Link="Production/BackgroundServiceChange.cs"/>
    <Compile Include="../../Models/WindowsServiceInfo.cs" Link="Production/WindowsServiceInfo.cs"/>
    <Compile Include="../../Services/SupportedBackgroundActions.cs" Link="Production/SupportedBackgroundActions.cs"/>
    <Compile Include="../../Services/BackgroundServiceManager.cs" Link="Production/BackgroundServiceManager.cs"/>
    <Compile Include="../../Services/BackgroundServiceHistoryStore.cs" Link="Production/BackgroundServiceHistoryStore.cs"/>
    <Compile Include="../../Services/WindowsServiceConfigurationAccess.cs" Link="Production/WindowsServiceConfigurationAccess.cs"/>
    <Compile Include="../../Services/AdminService.cs" Link="Production/AdminService.cs"/>
    <Compile Include="../../Services/BackgroundServiceActionCoordinator.cs" Link="Production/BackgroundServiceActionCoordinator.cs"/>
  </ItemGroup>
</Project>
